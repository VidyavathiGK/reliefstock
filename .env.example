# ReliefStock Environment Configuration Template (.env.example)

# Security & Debugging
SECRET_KEY=django-insecure-reliefstock-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=reliefstock_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=3

# Note: If running without a local PostgreSQL instance, you can temporarily switch DB_ENGINE:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
